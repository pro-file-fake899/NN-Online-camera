<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:src="@drawable/ic_nn_logo"
        android:contentDescription="NN Online Camera Logo" />

    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NN Online Camera"
        android:textColor="#0F172A"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/splashCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Created by Nabhnish Kumar"
        android:textColor="#2563EB"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
